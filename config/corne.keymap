#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
        };

        combo_del {
            bindings = <&kp DELETE>;
            key-positions = <10 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp LEFT_GUI  &kp Q  &kp W  &kp F      &kp P  &kp T      &kp J    &kp L  &kp U      &kp Y       &kp SEMICOLON  &kp BACKSPACE
&kp TAB       &kp A  &kp R  &kp S      &kp T  &kp G      &kp M    &kp N  &kp E      &kp I       &kp O          &kp SQT
&kp LSHFT     &kp Z  &kp X  &kp C      &kp D  &kp V      &kp K    &kp H  &kp COMMA  &kp PERIOD  &kp SLASH      &kp RSHIFT
                            &kp LCTRL  &mo 1  &kp SPACE  &kp RET  &mo 2  &kp RALT
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp ESC        &kp F1     &kp F2         &kp F3                &kp F4                 &kp F5         &kp EQUAL      &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_DIVIDE    &kp BACKSPACE
&kp LA(GRAVE)  &kp LG(E)  &kp LC(LG(T))  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp MINUS      &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MULTIPLY  &kp DELETE
&trans         &kp TAB    &kp MINUS      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH  &kp SEMICOLON  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERIOD       &kp TAB
                                         &kp LEFT_ALT          &trans                 &kp SPACE      &kp RET        &trans        &kp NUMBER_0
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp TAB       &kp F6         &kp F7            &kp F8        &kp F9      &kp F10       &kp PG_UP  &kp HOME        &kp UP_ARROW    &kp END            &kp BACKSPACE  &kp DEL
&kp LEFT_ALT  &bt BT_SEL 0   &bt BT_SEL 1      &bt BT_SEL 2  &soft_off   &kp CAPSLOCK  &kp PG_DN  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW    &kp DEL        &kp GRAVE
&kp LSHFT     &kp LS(LG(S))  &kp C_PLAY_PAUSE  &kp C_PREV    &kp C_NEXT  &kp DEL       &kp MINUS  &kp LA(SPACE)   &kp LS(F10)     &kp LA(LS(EQUAL))  &kp BACKSLASH  &kp TILDE
                                               &kp LCTRL     &trans      &kp SPACE     &kp RET    &trans          &kp RIGHT_ALT
            >;
        };
    };
};
